[common]
# l4ts 服务端地址与端口
server_addr = 127.0.0.1
server_port = 3007

# 认证密码，需与服务端 token 保持一致
token = 12345678

# 日志级别：trace, debug, info, warn, error
log_level = info

# 预建连接池数量
pool_count = 5

# 示例：将本地 Home Assistant 映射到公网远程端口 8123
[ha]
local_ip = 127.0.0.1
local_port = 8123
remote_port = 8123
health_check = true

# 示例：将本地 SSH 服务映射到公网远程端口 6000
[ssh]
local_ip = 127.0.0.1
local_port = 22
remote_port = 6000
health_check = false

